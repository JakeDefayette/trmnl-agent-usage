<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.trmnl.agent-usage</string>

	<key>ProgramArguments</key>
	<array>
		<!-- Replace with: which bun -->
		<string>__BUN_PATH__</string>
		<string>run</string>
		<string>src/index.ts</string>
	</array>

	<key>WorkingDirectory</key>
	<!-- Replace with your clone path -->
	<string>__PROJECT_PATH__</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<!-- Ensure bun's directory is included -->
		<string>__BUN_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>

	<key>StartInterval</key>
	<integer>480</integer>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/trmnl-agent-usage.log</string>

	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/trmnl-agent-usage.log</string>

	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
